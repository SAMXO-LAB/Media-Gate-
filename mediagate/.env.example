# ============================================================================
# MediaGate configuration. Copy to .env and fill in. Never commit real values.
# See docs/PLATFORM_SETUP.md for how to obtain each credential.
# ============================================================================

APP_ENV=production                        # development | production (production hides /docs, adds HSTS)
PUBLIC_API_URL=https://api.example.com    # used for OAuth redirect URIs and local file links
FRONTEND_URL=https://example.com          # where OAuth callbacks send the browser back
CORS_ORIGINS=https://example.com          # comma-separated
TRUST_PROXY_HEADERS=true                  # true only behind a proxy you control (for client IPs)

# ---- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                # Settings → API keys (secret). Server only!
# Leave empty for projects using asymmetric JWT signing keys (verified via JWKS).
# Set only for legacy HS256 projects: Settings → JWT Keys → Legacy JWT secret.
SUPABASE_JWT_SECRET=
# Session pooler or direct connection string (Settings → Database → Connect).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
STORAGE_BACKEND=supabase                  # supabase | local (local = single host with shared volume)
STORAGE_BUCKET=media-temp

# ---- Secrets owned by MediaGate --------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
STATE_SIGNING_KEY=

# ---- YouTube (metadata only) -----------------------------------------------
YOUTUBE_API_KEY=

# ---- Instagram (Instagram API with Instagram Login) -------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# ---- X (X API v2, pay-per-use) ----------------------------------------------
X_BEARER_TOKEN=                           # app-only token for public post metadata
X_CLIENT_ID=                              # OAuth 2.0 client ID (user connection)
X_CLIENT_SECRET=                          # only for confidential clients

# ---- Limits -----------------------------------------------------------------
MAX_FILE_BYTES=524288000                  # 500 MB
MAX_DURATION_SECONDS=3600
HTTP_TIMEOUT_SECONDS=20
DOWNLOAD_TIMEOUT_SECONDS=600
FFMPEG_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=2
MAX_ACTIVE_JOBS_PER_USER=3
RESULT_TTL_SECONDS=3600                   # processed files are deleted after this
SIGNED_URL_TTL_SECONDS=120                # each download link works for 2 minutes
STALE_JOB_SECONDS=1800
RATE_LIMIT_ANALYZE_PER_MIN=20
RATE_LIMIT_JOBS_PER_MIN=5
REDIS_URL=                                # required for >1 API replica, e.g. redis://redis:6379/0

# ---- Frontend (build-time, public) -------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # anon / publishable key (safe to expose; RLS protects data)
